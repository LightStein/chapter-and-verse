# Copy to .env and fill in. .env is gitignored.

# Anthropic API key, from https://console.anthropic.com
# Use a WORKSPACE-scoped key (sk-ant-api...). An account-scoped key
# (sk-ant-usr...) belongs to no workspace and the API rejects it unless you
# also set ANTHROPIC_WORKSPACE_ID below.
ANTHROPIC_API_KEY=

# Only if your key is account-scoped rather than workspace-scoped.
ANTHROPIC_WORKSPACE_ID=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user id. The bot answers you anywhere, and anyone
# in a chat listed in gateway/registry.json.
ALLOWED_USER_ID=

# ru (default) or en. See engine/locales/.
CV_LOCALE=ru

# Opus 5.5 is the default: most capable, ~$0.13 per question on a 56-document
# corpus. claude-sonnet-5-5 is ~2x cheaper, claude-haiku-4-5 ~5x.
ASK_API_MODEL=claude-opus-5-5
